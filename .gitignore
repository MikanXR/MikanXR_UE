# Build outputs, for the project and the plugin
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# The vendored MikanXR client SDK is committed, its debug symbols are not
Plugins/MikanXR_UE/ThirdParty/**/*.pdb

# Generated by Unreal Build Tool and Visual Studio
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.sdf
*.VC.db
*.opendb
*.code-workspace
.vsconfig

# Machine-local bindings written by BindUnrealEngine.bat and BindMikan.bat
SetUnrealEngineVars_x64.bat
SetMikanVars_x64.bat

__pycache__/
*.pyc
